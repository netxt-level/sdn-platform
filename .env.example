POSTGRES_DB=sdn_platform
POSTGRES_USER=sdn_user
POSTGRES_PASSWORD=sdn_password
POSTGRES_HOST_PORT=5433

INFLUXDB_USERNAME=sdn_user
INFLUXDB_PASSWORD=sdn_password
INFLUXDB_ORG=sdn_org
INFLUXDB_BUCKET=sdn_metrics
INFLUXDB_TOKEN=influx_id_token
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086

ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

ANALYZER_ID=analyzer-1
ANALYZER_INTERFACE=eth0
ANALYZER_WINDOW_SEC=1
ANALYZER_STATUS_INTERVAL_SEC=5
PORT_SCAN_WINDOW_SEC=5
PORT_SCAN_UNIQUE_DST_PORT_THRESHOLD=20
PORT_SCAN_SYN_COUNT_THRESHOLD=20
PORT_SCAN_MULTI_TARGET_WINDOW_SEC=30
PORT_SCAN_MULTI_TARGET_THRESHOLD=3
PORT_SCAN_HIGH_UNIQUE_DST_PORT_THRESHOLD=50
PORT_SCAN_ALERT_COOLDOWN_SEC=60
ICMP_PPS_THRESHOLD=1000
ICMP_MIN_PACKET_COUNT=1000
ICMP_HIGH_PPS_THRESHOLD=3000
ICMP_HIGH_PPS_MULTIPLIER=3.0
ICMP_BASELINE_SPIKE_MULTIPLIER=5.0
ICMP_BASELINE_MIN_PPS=100
ICMP_ALERT_COOLDOWN_SEC=60
EVENT_DEDUP_WINDOW_SEC=60
RATE_LIMIT_PRIORITY=500
RATE_LIMIT_IDLE_TIMEOUT=60
RATE_LIMIT_HARD_TIMEOUT=300
RATE_LIMIT_PPS=100
BACKEND_BASE_URL=http://backend:8000

# Multipass 사용 시 host.docker.internal을 start.sh가 출력한 VM IP로 교체한다.
CONTROLLER_BASE_URL=http://host.docker.internal:8080
CONTROLLER_TIMEOUT_SECONDS=8
CONTROLLER_MAX_ATTEMPTS=2

FRONTEND_PORT=3000
FRONTEND_BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/analyzer
