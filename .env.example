# =================================================================
# [SDN Gateway Project] Environment Variables Template
# 관리자: Jung TaeKyung
# 이 파일은 템플릿임. 실제 가동 시에는 .env로 복사하여 값을 채워야함.
# =================================================================

# --- 1. Infrastructure Ports (로컬 호스트 접속용) ---
# 내 PC(윈도우)에서 브라우저나 DB 툴로 접속할 때 사용하는 외부 포트.
# 다른 프로그램과 포트가 겹칠 경우 이 숫자만 수정하면 됨.

# MySQL 데이터베이스 접속 포트 (기본: 3306)
PORT_MYSQL_EXTERNAL=3306
# InfluxDB 웹 UI 및 API 접속 포트 (기본: 8086)
PORT_INFLUX_EXTERNAL=8086
# Ryu 컨트롤러 REST API 접속 포트 (기본: 8080)
PORT_RYU_REST=8080
# 분석 엔진(FastAPI) API 접속 포트 (기본: 8000)
PORT_ANALYSIS_API=8000
# 관리자 대시보드(React) 브라우저 접속 포트 (기본: 3000)
PORT_DASHBOARD=3000

# --- 2. MySQL Secrets (관계형 DB - 정책 및 로그 관리) ---
# 보안 원칙: Root 계정은 인프라 관리용으로만 쓰고, 앱은 일반 유저 계정을 사용.

# DB 전체 제어권한을 가진 관리자 비밀번호
MYSQL_ROOT_PASSWORD=
# 프로젝트 전용 데이터베이스 이름 (예: sdn_security)
MYSQL_DATABASE=sdn_security
# 분석 엔진(FastAPI)이 실제로 사용할 서비스 계정명 (예: sdn_user)
MYSQL_APP_USER=
# 서비스 계정 전용 비밀번호
MYSQL_APP_PASSWORD=

# --- 3. InfluxDB Secrets (시계열 DB - 트래픽 통계) ---
# InfluxDB 2.x는 조직, 버킷, 토큰 기반으로 작동하며 초기 계정 설정이 필요합니다.

# 초기 설치 시 생성할 관리자 계정명 (예: sdn_admin)
INFLUXDB_ADMIN_USER=
# 관리자 계정의 비밀번호
INFLUXDB_ADMIN_PASSWORD=
# 분석 엔진이 데이터를 읽고 쓸 때 사용하는 API 토큰 (최종 권한 열쇠)
INFLUXDB_ADMIN_TOKEN=
# 조직명 (예: netxt_level)
INFLUXDB_ADMIN_ORG=sdn_org
# 데이터 저장 버킷 이름 (예: traffic_stats)
INFLUXDB_ADMIN_BUCKET=traffic_data

# --- 4. Service Hostnames (도커 내부 네트워크 전용) ---
# 컨테이너끼리 통신할 때 사용하는 이름. docker-compose의 서비스명과 일치해야 함.
HOST_RYU=ryu-controller
HOST_ANALYSIS=analysis-engine
HOST_MYSQL=mysql-db
HOST_INFLUX=influx-db

# --- 5. Dashboard to API Connection ---
# 리액트 대시보드가 브라우저에서 어느 백엔드로 요청을 보낼지 결정.
# 로컬 개발 환경에서는 localhost를 사용.
REACT_APP_API_HOST=localhost