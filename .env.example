POSTGRES_DB=sdn_platform
POSTGRES_USER=sdn_user
# Generate a unique value before starting the stack, for example:
# openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
POSTGRES_HOST_PORT=5433

INFLUXDB_USERNAME=sdn_user
INFLUXDB_PASSWORD=replace-with-a-unique-influxdb-password
INFLUXDB_ORG=sdn_org
INFLUXDB_BUCKET=sdn_metrics
INFLUXDB_TOKEN=replace-with-a-unique-influxdb-token
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086

# Generate independent values for each service boundary.
ADMIN_API_KEY=replace-with-a-unique-admin-api-key
ANALYZER_API_KEY=replace-with-a-unique-analyzer-api-key
CONTROLLER_API_KEY=replace-with-a-unique-controller-api-key
WEBSOCKET_TOKEN_SECRET=replace-with-a-unique-websocket-signing-secret
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEBSOCKET_TOKEN_TTL_SECONDS=60
WEBSOCKET_SEND_TIMEOUT_SECONDS=2
ALLOW_INSECURE_DEV_AUTH=false

ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

ANALYZER_ID=analyzer-1
ANALYZER_INTERFACE=eth0
ANALYZER_WINDOW_SEC=1
ANALYZER_STATUS_INTERVAL_SEC=5
ANALYZER_OUTBOX_PATH=/var/lib/sdn-analyzer/outbox.db
ANALYZER_OUTBOX_DELIVERY_POLL_SEC=1
ANALYZER_OUTBOX_DELIVERY_BATCH_SIZE=100
ANALYZER_OUTBOX_RETRY_BASE_SEC=1
ANALYZER_OUTBOX_RETRY_MAX_SEC=60
PORT_SCAN_WINDOW_SEC=5
PORT_SCAN_UNIQUE_DST_PORT_THRESHOLD=20
PORT_SCAN_SYN_COUNT_THRESHOLD=20
PORT_SCAN_MULTI_TARGET_WINDOW_SEC=30
PORT_SCAN_MULTI_TARGET_THRESHOLD=3
PORT_SCAN_HIGH_UNIQUE_DST_PORT_THRESHOLD=50
PORT_SCAN_ALERT_COOLDOWN_SEC=60
ICMP_PPS_THRESHOLD=1000
ICMP_MIN_PACKET_COUNT=1000
ICMP_HIGH_PPS_THRESHOLD=3000
ICMP_HIGH_PPS_MULTIPLIER=3.0
ICMP_BASELINE_SPIKE_MULTIPLIER=5.0
ICMP_BASELINE_MIN_PPS=100
ICMP_ALERT_COOLDOWN_SEC=60
EVENT_DEDUP_WINDOW_SEC=60
RATE_LIMIT_PRIORITY=500
RATE_LIMIT_IDLE_TIMEOUT=60
RATE_LIMIT_HARD_TIMEOUT=300
RATE_LIMIT_PPS=100
BACKEND_BASE_URL=http://backend:8000

# Multipass 사용 시 host.docker.internal을 start.sh가 출력한 VM IP로 교체한다.
CONTROLLER_BASE_URL=http://host.docker.internal:8080
CONTROLLER_TIMEOUT_SECONDS=8
CONTROLLER_MAX_ATTEMPTS=2
FLOW_RECONCILE_INTERVAL_SECONDS=30
SWITCH_PORT_CAPACITY_BPS=10000000
CONTROLLER_STATS_INTERVAL_SECONDS=1
PATH_CAPACITY_PPS=1000
PATH_DISTRIBUTION_THRESHOLD_PPS=800
PATH_DISTRIBUTION_RECOVERY_PPS=600

FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
INFLUXDB_BIND_ADDRESS=127.0.0.1
ELASTICSEARCH_BIND_ADDRESS=127.0.0.1
FRONTEND_BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/analyzer
